<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Suzuki</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      text-align: center;
      background: #f5f5f5;
    }

    h1 {
      margin-top: 40px;
      font-size: 42px;
    }

    img {
      width: 90%;
      max-width: 500px;
      border-radius: 15px;
      margin: 20px 0;
    }

    button {
      background: #e30613;
      color: white;
      border: none;
      padding: 15px 35px;
      font-size: 20px;
      border-radius: 10px;
    }
  </style>
</head>

<body>

  <h1>Suzuki</h1>

  <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=900&q=80"
       alt="Motocicleta">

  <br>

  <button>Asesorar</button>

